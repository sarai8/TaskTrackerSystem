@model TaskDto

<div class="d-flex justify-content-between align-items-center">
    <h1>@Model.Title</h1>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Görevlere Dön
        </a>

        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">
            Düzenle
        </a>
    </div>
</div>

<div class="card p-4 mt-3">
    <p>@Model.Description</p>

    <hr />

    <div class="row">
        <div class="col-md-4">
            <strong>Durum</strong>
            <div>@Model.Status</div>
        </div>

        <div class="col-md-4">
            <strong>Öncelik</strong>
            <div>@Model.Priority</div>
        </div>

        <div class="col-md-4">
            <strong>Son Tarih</strong>
            <div>@Model.DueDate.ToString("dd.MM.yyyy HH:mm")</div>
        </div>
    </div>
</div>