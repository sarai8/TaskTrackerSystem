@model List<TaskTrackerSystem.Web.ViewModels.DepartmentRequestViewModel>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Departman İstekleri</h1>
</div>

<div class="card">
    <div class="list-group list-group-flush">
        @if (!Model.Any())
        {
            <div class="list-group-item text-muted small">Onay bekleyen istek yok.</div>
        }
        else
        {
            @foreach (var r in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">@r.UserName <span class="text-muted small">(@r.UserEmail)</span></div>
                        <div class="small text-muted">
                            <strong>@r.DepartmentName</strong> departmanına katılmak istiyor —
                            @r.RequestedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <form asp-action="Approve" asp-route-id="@r.Id" method="post">
                            <button class="btn btn-sm btn-success">Onayla</button>
                        </form>

                        <form asp-action="Reject" asp-route-id="@r.Id" method="post">
                            <button class="btn btn-sm btn-outline-danger">Reddet</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>