@model List<TaskTrackerSystem.Web.ViewModels.TaskApprovalViewModel>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Onay Bekleyen Görevler</h1>
</div>

<div class="card">
    <div class="list-group list-group-flush">
        @if (!Model.Any())
        {
            <div class="list-group-item text-muted small">Onay bekleyen görev yok.</div>
        }
        else
        {
            @foreach (var p in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-semibold">@p.Title</div>
                        <div class="small text-muted">
                            @p.ClaimedByName (@p.ClaimedByEmail) üstlendi — Son tarih: @p.DueDate.ToString("dd.MM.yyyy HH:mm")
                        </div>
                        <span class="badge @(p.Priority == TaskTrackerSystem.Domain.Enums.TaskPriority.High ? "badge-high" : p.Priority == TaskTrackerSystem.Domain.Enums.TaskPriority.Medium ? "badge-medium" : "badge-low")">
                            @p.Priority
                        </span>
                    </div>

                    <div class="d-flex gap-2">
                        <form asp-action="Approve" asp-route-id="@p.Id" method="post">
                            <button class="btn btn-sm btn-success">Onayla</button>
                        </form>

                        <form asp-action="Reject" asp-route-id="@p.Id" method="post">
                            <button class="btn btn-sm btn-outline-danger">Reddet</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>