@model TaskTrackerSystem.Web.ViewModels.AdminUserEditViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card p-4 shadow-sm">
            <h2 class="mb-4">Kullanıcıyı Düzenle</h2>

            <div asp-validation-summary="All" class="text-danger"></div>

            <form method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Departman</label>
                    <select asp-for="DepartmentId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Departments, "Id", "Name"))">
                        <option value="">Departman yok</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Rol</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Employee">Çalışan</option>
                        <option value="DepartmentManager">Departman Yöneticisi</option>
                        <option value="Director">Müdür</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary">Kaydet</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
                </div>
            </form>
        </div>
    </div>
</div>