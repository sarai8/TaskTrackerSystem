@model TaskTrackerSystem.Web.Controllers.AdminDashboardVm

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Admin Paneli</h1>
        <p class="text-muted mb-0">Sistem genelindeki durum özeti.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted">Kullanıcı</div>
            <div class="stat">@Model.TotalUsers</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted">Departman</div>
            <div class="stat">@Model.TotalDepartments</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted">Görev</div>
            <div class="stat">@Model.TotalTasks</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3">
            <div class="text-muted">Bekleyen Onay</div>
            <div class="stat">@Model.PendingApprovals</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <h5 class="mb-3">Görev Durum Grafiği</h5>
            <div style="height:300px;"><canvas id="taskStatusChart"></canvas></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <h5 class="mb-3">Kullanıcı Rolleri</h5>
            <div style="height:300px;"><canvas id="userRolesChart"></canvas></div>
        </div>
    </div>
</div>

<div class="card p-3 mb-4">
    <h5 class="mb-3">Departman Özeti</h5>
    @if (!Model.Departments.Any())
    {
        <p class="text-muted small mb-0">Henüz departman eklenmemiş.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter">
                <thead><tr><th>Departman</th><th>Çalışan</th><th>Aktif Görev</th></tr></thead>
                <tbody>
                    @foreach (var d in Model.Departments)
                    {
                        <tr>
                            <td>@d.Name</td>
                            <td>@d.EmployeeCount çalışan</td>
                            <td>@d.ActiveTaskCount aktif görev</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="card p-3">
    <h5 class="mb-3">Hızlı İşlemler</h5>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-controller="Admin" asp-action="Create"><i class="bi bi-person-plus"></i> Kullanıcı Ekle</a>
        <a class="btn btn-outline-dark" asp-controller="Admin" asp-action="Index"><i class="bi bi-people"></i> Kullanıcı Yönet</a>
        <a class="btn btn-outline-dark" asp-controller="Departments" asp-action="Index"><i class="bi bi-diagram-3"></i> Departmanlar</a>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
    new Chart(document.getElementById('taskStatusChart'), {
        type: 'doughnut',
        data: {
            labels: ['Bekleyen', 'Devam Ediyor', 'Tamamlanan'],
            datasets: [{ data: [@Model.Pending, @Model.InProgress, @Model.Completed], backgroundColor: ['#f59f00', '#4263eb', '#2fb344'] }]
        },
        options: { responsive: true, maintainAspectRatio: false }
    });

    new Chart(document.getElementById('userRolesChart'), {
        type: 'bar',
        data: {
            labels: ['Admin', 'Müdür', 'Departman Yöneticisi', 'Çalışan'],
            datasets: [{ label: 'Kullanıcı Sayısı', data: [@Model.AdminCount, @Model.DirectorCount, @Model.ManagerCount, @Model.EmployeeCount], backgroundColor: '#4263eb' }]
        },
        options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }, plugins: { legend: { display: false } } }
    });
</script>