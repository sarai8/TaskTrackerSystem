    <div class="col-md-6">
        <div class="card h-100">

            <div class="card-body">

                <h2 class="h2 text-center mb-4">Giriş Yap</h2>

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <form method="post" autocomplete="off">

                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-2">

                        <label asp-for="Password"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   id="loginPassword" />

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    id="toggleLoginPassword">

                                <i class="bi bi-eye"
                                   id="loginPasswordIcon">
                                </i>

                            </button>

                        </div>

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label class="form-check">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <span class="form-check-label">
                                Beni hatırla
                            </span>

                        </label>

                    </div>


                    <div class="form-footer">

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Giriş Yap
                        </button>

                    </div>

                </form>

            </div>


            <div class="hr-text">
                veya
            </div>


            <div class="card-body text-center">

                <p class="mb-1">
                    <a asp-action="ForgotPassword">
                        Şifremi unuttum
                    </a>
                </p>

                <p class="mb-0">
                    Hesabın yok mu?
                    <a asp-action="Register"
                       class="fw-medium">
                        Kayıt ol
                    </a>
                </p>

            </div>

        </div>
    </div>

</div>


<script>

    document
        .getElementById("toggleLoginPassword")
        .addEventListener("click", function() {

            const passwordInput =
                document.getElementById("loginPassword");

            const icon =
                document.getElementById("loginPasswordIcon");

            if (passwordInput.type === "password") {

                passwordInput.type = "text";

                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");

            } else {

                passwordInput.type = "password";

                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        });


    function copyDemoInfo(elementId) {

        const input =
            document.getElementById(elementId);

        navigator.clipboard.writeText(input.value);
    }

</script>