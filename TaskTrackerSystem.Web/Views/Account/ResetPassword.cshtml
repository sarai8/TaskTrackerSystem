@model ResetPasswordViewModel

<div class="card card-md">
    <div class="card-body">
        <h2 class="h2 text-center mb-4">Şifre Yenile</h2>

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form method="post">
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div class="mb-3">
                <label asp-for="Password" class="form-label">
                    Yeni Şifre
                </label>

                <div class="input-group">
                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           id="resetPassword" />

                    <button type="button"
                            class="btn btn-outline-secondary"
                            id="toggleResetPassword"
                            aria-label="Şifreyi göster">

                        <i class="bi bi-eye" id="resetPasswordIcon"></i>

                    </button>
                </div>

                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">
                    Yeni Şifre Tekrar
                </label>

                <div class="input-group">
                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           id="resetConfirmPassword" />

                    <button type="button"
                            class="btn btn-outline-secondary"
                            id="toggleResetConfirmPassword"
                            aria-label="Şifreyi göster">

                        <i class="bi bi-eye" id="resetConfirmPasswordIcon"></i>

                    </button>
                </div>

                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-footer">
                <button type="submit" class="btn btn-primary w-100">
                    Şifreyi Yenile
                </button>
            </div>
        </form>
    </div>

    <div class="card-body text-center pt-0">
        <p class="mb-0">
            <a asp-action="Login">Giriş sayfasına dön</a>
        </p>
    </div>

    <script>
            document.getElementById("toggleResetPassword").addEventListener("click", function() {

                const passwordInput = document.getElementById("resetPassword");
                const icon = document.getElementById("resetPasswordIcon");

                if (passwordInput.type === "password") {

                    passwordInput.type = "text";

                    icon.classList.remove("bi-eye");
                    icon.classList.add("bi-eye-slash");

                    this.setAttribute("aria-label", "Şifreyi gizle");

                } else {

                    passwordInput.type = "password";

                    icon.classList.remove("bi-eye-slash");
                    icon.classList.add("bi-eye");

                    this.setAttribute("aria-label", "Şifreyi göster");
                }
            });


            document.getElementById("toggleResetConfirmPassword").addEventListener("click", function() {

                const passwordInput = document.getElementById("resetConfirmPassword");
                const icon = document.getElementById("resetConfirmPasswordIcon");

                if (passwordInput.type === "password") {

                    passwordInput.type = "text";

                    icon.classList.remove("bi-eye");
                    icon.classList.add("bi-eye-slash");

                    this.setAttribute("aria-label", "Şifreyi gizle");

                } else {

                    passwordInput.type = "password";

                    icon.classList.remove("bi-eye-slash");
                    icon.classList.add("bi-eye");

                    this.setAttribute("aria-label", "Şifreyi göster");
                }
            });
    </script>
</div>